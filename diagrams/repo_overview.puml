@startuml

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangleBorderThickness 2
skinparam arrowColor #555555
skinparam arrowThickness 2

title <b><size:18>MCU & IC Architecture Repo</size></b>\n<size:11>From silicon block diagrams to register-level details</size>\n

together {
  rectangle "<b><size:14>SI4735</size></b>\nAM/FM/SW Tuner + DSP\nSilicon Labs\n\n<size:10>Architecture  .  DSP Details  .  Registers\nPinout  .  Power  .  Firmware</size>" as SI #A5D6A7
  rectangle "<b><size:14>ESP32-WROOM-32</size></b>\nWiFi/BT SoC, Xtensa LX6\nEspressif\n\n<size:10>Architecture  .  WiFi/BT  .  Registers\nPinout  .  Power  .  Security  .  Firmware</size>" as ESP #A5D6A7
}

together {
  rectangle "<b>Tuner ICs</b>\nSI4703  .  RDA5807  .  RTL2832U  .  R820T2  .  CC1101" as TUN #FFE0B2
  rectangle "<b>MCUs</b>\nATmega328P  .  RP2040  .  STM32F103  .  ESP32-C3" as MCU #BBDEFB
}

rectangle "<b>Cross-Chip Resources</b>\nComparative Analysis  .  PlantUML Diagrams  .  Code Examples  .  References" as RES #E1BEE7

SI -down-> TUN
ESP -down-> MCU
TUN -down-> RES
MCU -down-> RES

@enduml
